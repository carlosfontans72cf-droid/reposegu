rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isSuper() {
      return signedIn() && miPerfil().rol == 'superadmin';
    }

    function enEmpresa(empresaId) {
      return signedIn() && miPerfil().empresaId == empresaId && miPerfil().activo == true;
    }

    function rolEn(empresaId, roles) {
      return enEmpresa(empresaId) && miPerfil().rol in roles;
    }

    // ---------- Perfiles de usuario (equipo y superadmin) ----------
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuper()
                    || rolEn(resource.data.empresaId, ['dueno', 'admin']));
      allow list: if signedIn() && (isSuper()
                    || rolEn(resource.data.empresaId, ['dueno', 'admin']));

      // Alta del dueño al crear su empresa (en el mismo lote que la empresa).
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['empresaId', 'rol', 'nombre', 'email', 'idioma', 'activo', 'creadoEn', 'terminosVersion', 'terminosEn'])
        && request.resource.data.terminosVersion is string
        && request.resource.data.terminosEn == request.time
        && request.resource.data.rol == 'dueno'
        && request.resource.data.activo == true
        && getAfter(/databases/$(database)/documents/empresas/$(request.resource.data.empresaId)).data.ownerUid == uid;

      // Alta de un integrante que fue invitado por email.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['empresaId', 'rol', 'nombre', 'email', 'idioma', 'activo', 'creadoEn', 'terminosVersion', 'terminosEn'])
        && request.resource.data.terminosVersion is string
        && request.resource.data.terminosEn == request.time
        && request.resource.data.activo == true
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email.lower()
        && exists(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower())).data.empresaId == request.resource.data.empresaId
        && get(/databases/$(database)/documents/invitaciones/$(request.auth.token.email.lower())).data.rol == request.resource.data.rol;

      // Alta de una cuenta con nombre y código (sin email real), creada por el dueño o administrador.
      // La persona acepta los términos al primer ingreso. Solo el dueño crea administradores.
      allow create: if signedIn() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['empresaId', 'rol', 'nombre', 'email', 'idioma', 'activo',
             'acceso', 'creadoPor', 'creadoEn'])
        && request.resource.data.acceso == 'codigo'
        && request.resource.data.activo == true
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.email.matches('^[a-z0-9.-]+@acceso\\.invalid$')
        && request.resource.data.rol in ['admin', 'empleado']
        && (request.resource.data.rol == 'empleado' || rolEn(request.resource.data.empresaId, ['dueno']))
        && rolEn(request.resource.data.empresaId, ['dueno', 'admin']);

      // Cada persona edita solo su nombre e idioma, y acepta los términos vigentes.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'idioma', 'terminosVersion', 'terminosEn']);

      // El dueño gestiona a los demás: activar, desactivar y cambiar rol (nunca a otro dueño).
      allow update: if signedIn() && rolEn(resource.data.empresaId, ['dueno'])
        && resource.data.rol != 'dueno'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol', 'activo'])
        && request.resource.data.rol in ['admin', 'empleado'];
    }

    // ---------- Invitaciones (id = email en minúsculas) ----------
    match /invitaciones/{email} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['empresaId', 'rol', 'creadaEn'])
        && request.resource.data.rol in ['admin', 'empleado']
        && rolEn(request.resource.data.empresaId, ['dueno', 'admin']);
      allow get: if signedIn() && (request.auth.token.email.lower() == email
                    || rolEn(resource.data.empresaId, ['dueno', 'admin']));
      allow list: if signedIn() && rolEn(resource.data.empresaId, ['dueno', 'admin']);
      allow delete: if signedIn() && (request.auth.token.email.lower() == email
                    || rolEn(resource.data.empresaId, ['dueno', 'admin']));
    }

    // ---------- Empresas ----------
    match /empresas/{empresaId} {
      allow read: if signedIn() && (isSuper() || enEmpresa(empresaId));

      // Una empresa nueva siempre nace en prueba, con no más de 31 días.
      // Requiere email verificado (evita altas masivas con correos ajenos) y solo
      // admite los campos esperados.
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['nombre', 'vertical', 'pais', 'moneda', 'zonaHoraria',
             'idiomaDefecto', 'whatsapp', 'marca', 'plan', 'estado', 'finPrueba', 'venceEl', 'ownerUid', 'creadoEn'])
        && request.resource.data.moneda in ['UYU', 'ARS', 'BRL']
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estado == 'prueba'
        && request.resource.data.plan == 'prueba'
        && request.resource.data.venceEl == null
        && request.resource.data.finPrueba <= request.time + duration.value(31, 'd')
        && request.resource.data.vertical in ['pasteleria', 'seguridad']
        && request.resource.data.pais in ['UY', 'AR', 'BR'];

      // El dueño y el administrador editan solo datos del negocio, nunca el plan.
      allow update: if signedIn() && rolEn(empresaId, ['dueno', 'admin'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre', 'whatsapp', 'marca', 'idiomaDefecto', 'zonaHoraria']);

      // El superadmin gestiona plan, estado y vencimientos.
      allow update: if isSuper();
    }

    // ---------- Módulos de la pastelería (todo cuelga de la empresa) ----------
    // Cualquier subcolección sin regla propia queda cerrada.
    function esGestor(empresaId) {
      return rolEn(empresaId, ['dueno', 'admin']);
    }

    // Productos y recetas: los ve el equipo, los edita dueño y administrador.
    match /empresas/{empresaId}/productos/{id} {
      allow read: if enEmpresa(empresaId);
      allow create, update, delete: if esGestor(empresaId);
    }

    // Insumos (stock): el empleado solo puede ajustar la cantidad en stock.
    match /empresas/{empresaId}/insumos/{id} {
      allow read: if enEmpresa(empresaId);
      allow create, delete: if esGestor(empresaId);
      allow update: if esGestor(empresaId)
        || (enEmpresa(empresaId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }

    match /empresas/{empresaId}/clientes/{id} {
      allow read, create, update: if enEmpresa(empresaId);
      allow delete: if esGestor(empresaId);
    }

    match /empresas/{empresaId}/pedidos/{id} {
      allow read: if enEmpresa(empresaId);
      allow create, update: if enEmpresa(empresaId)
        && request.resource.data.estado in ['nuevo', 'confirmado', 'preparacion', 'listo', 'entregado', 'cancelado'];
      allow delete: if esGestor(empresaId);
    }

    match /empresas/{empresaId}/zonas/{id} {
      allow read: if enEmpresa(empresaId);
      allow create, update, delete: if esGestor(empresaId);
    }

    // Contador de pedidos: solo puede crearse en 1 o subir de a uno.
    match /empresas/{empresaId}/config/pedidos {
      allow read: if enEmpresa(empresaId);
      allow create: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == 1;
      allow update: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['ultimo'])
        && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    // Accesos con código: guardan el código vigente para poder reenviarlo. Solo la gestión.
    match /empresas/{empresaId}/accesos/{uid} {
      allow read, create, update, delete: if esGestor(empresaId);
    }

    // ---------- Módulos de seguridad (todo cuelga de la empresa) ----------
    // Dueño y administrador ven y gestionan todo. El guardia (empleado) solo ve lo suyo
    // y solo puede crear sus propios registros, con la hora puesta por el servidor.
    function esYo(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function esMio(empresaId) {
      return enEmpresa(empresaId) && request.auth.uid == resource.data.uid;
    }

    match /empresas/{empresaId}/puestos/{id} {
      allow read: if enEmpresa(empresaId);
      allow create, update, delete: if esGestor(empresaId);
    }

    // Personal: la ficha tiene el mismo id que el usuario. El guardia lee la suya.
    match /empresas/{empresaId}/personal/{uid} {
      allow read: if esGestor(empresaId) || (enEmpresa(empresaId) && esYo(uid));
      allow create, update, delete: if esGestor(empresaId);
    }

    // Turnos: el guardia solo ve los turnos donde está asignado.
    match /empresas/{empresaId}/turnos/{id} {
      allow read: if esGestor(empresaId)
        || (enEmpresa(empresaId) && request.auth.uid in resource.data.guardias);
      allow create, update: if esGestor(empresaId)
        && request.resource.data.keys().hasOnly(['puestoId', 'puestoNombre', 'inicio', 'fin',
             'requeridos', 'guardias', 'notas', 'creadoEn'])
        && request.resource.data.guardias.size() <= 500;
      allow delete: if esGestor(empresaId);
    }

    // Asistencia: el guardia marca su propia entrada y cierra su propia salida.
    match /empresas/{empresaId}/asistencias/{id} {
      allow read: if esGestor(empresaId) || esMio(empresaId);
      allow create: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'turnoId', 'puestoId', 'puestoNombre',
             'turnoInicio', 'entrada', 'entradaPos', 'salida', 'salidaPos', 'abierta'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.entrada == request.time
        && request.resource.data.abierta == true
        && request.resource.data.salida == null;
      allow update: if enEmpresa(empresaId)
        && resource.data.uid == request.auth.uid
        && resource.data.abierta == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salida', 'salidaPos', 'abierta'])
        && request.resource.data.abierta == false
        && request.resource.data.salida == request.time;
      allow delete: if esGestor(empresaId);
    }

    // Rondas: el guardia las inicia, marca puntos y las termina.
    match /empresas/{empresaId}/rondas/{id} {
      allow read: if esGestor(empresaId) || esMio(empresaId);
      allow create: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'puestoId', 'puestoNombre', 'plan',
             'marcas', 'inicio', 'fin', 'estado', 'completa'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.inicio == request.time
        && request.resource.data.estado == 'en_curso'
        && request.resource.data.marcas.size() == 0
        && request.resource.data.plan.size() <= 100;
      allow update: if enEmpresa(empresaId)
        && resource.data.uid == request.auth.uid
        && resource.data.estado == 'en_curso'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcas', 'estado', 'completa', 'fin'])
        && request.resource.data.marcas.size() <= 100;
      allow delete: if esGestor(empresaId);
    }

    // Incidentes: los crea el guardia (abiertos); solo la gestión los revisa.
    match /empresas/{empresaId}/incidentes/{id} {
      allow read: if esGestor(empresaId) || esMio(empresaId);
      allow create: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'puestoId', 'puestoNombre', 'tipo',
             'gravedad', 'descripcion', 'fotos', 'video', 'pos', 'estado', 'notaGestion', 'creadoEn'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'abierto'
        && request.resource.data.tipo in ['robo', 'intrusion', 'agresion', 'incendio', 'accidente', 'dano', 'sospechoso', 'otro']
        && request.resource.data.gravedad in ['baja', 'media', 'alta']
        && request.resource.data.descripcion.size() <= 2000
        && request.resource.data.fotos.size() <= 4;
      allow update: if esGestor(empresaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'notaGestion', 'revisadoEn'])
        && request.resource.data.estado in ['abierto', 'revisado', 'cerrado'];
      allow delete: if esGestor(empresaId);
    }

    // Alertas de pánico / ayuda: las crea el guardia; la gestión las atiende;
    // el guardia solo puede cancelar la suya (falsa alarma).
    match /empresas/{empresaId}/alertas/{id} {
      allow read: if esGestor(empresaId) || esMio(empresaId);
      allow create: if enEmpresa(empresaId)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'telefono', 'puestoNombre', 'tipo',
             'pos', 'estado', 'creadoEn'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'activa'
        && request.resource.data.tipo in ['panico', 'ayuda'];
      allow update: if (esGestor(empresaId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'atendidaPor', 'atendidaEn', 'nota'])
            && request.resource.data.estado in ['atendida', 'cancelada'])
        || (enEmpresa(empresaId)
            && resource.data.uid == request.auth.uid
            && resource.data.estado == 'activa'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && request.resource.data.estado == 'cancelada');
    }

    // Ubicación en vivo: un documento por guardia (id = uid). Solo la ve la gestión.
    match /empresas/{empresaId}/ubicaciones/{uid} {
      allow read: if esGestor(empresaId);
      allow create, update: if enEmpresa(empresaId) && esYo(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'lat', 'lng', 'precision', 'puestoNombre', 'actualizadoEn'])
        && request.resource.data.uid == uid
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if enEmpresa(empresaId) && (esYo(uid) || esGestor(empresaId));
    }

    // Chat: un hilo por guardia (id = uid del guardia), entre él y la gestión.
    match /empresas/{empresaId}/chats/{uid} {
      allow read: if esGestor(empresaId) || (enEmpresa(empresaId) && esYo(uid));
      // Gestión: puede escribir todos los campos, pero el último mensaje es suyo.
      allow create: if esGestor(empresaId)
        && request.resource.data.keys().hasOnly(['guardiaUid', 'guardiaNombre', 'ultimoTexto', 'ultimoDe',
             'ultimo', 'leidoGuardia', 'leidoGestion'])
        && request.resource.data.get('ultimoDe', 'gestion') == 'gestion';
      allow update: if esGestor(empresaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoTexto', 'ultimoDe', 'ultimo', 'leidoGestion'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoDe'])
            || request.resource.data.ultimoDe == 'gestion');
      // Guardia: solo su hilo y solo los campos de su lado.
      allow create: if enEmpresa(empresaId) && esYo(uid)
        && request.resource.data.keys().hasOnly(['guardiaUid', 'guardiaNombre', 'ultimoTexto', 'ultimoDe',
             'ultimo', 'leidoGuardia'])
        && request.resource.data.guardiaUid == uid
        && request.resource.data.get('ultimoDe', 'guardia') == 'guardia';
      allow update: if enEmpresa(empresaId) && esYo(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guardiaNombre', 'ultimoTexto', 'ultimoDe', 'ultimo', 'leidoGuardia'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoDe'])
            || request.resource.data.ultimoDe == 'guardia');
    }

    match /empresas/{empresaId}/chats/{uid}/mensajes/{id} {
      allow read: if esGestor(empresaId) || (enEmpresa(empresaId) && esYo(uid));
      allow create: if request.resource.data.keys().hasOnly(['de', 'nombre', 'lado', 'texto', 'creadoEn'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1000
        && ((request.resource.data.lado == 'guardia' && enEmpresa(empresaId) && esYo(uid))
            || (request.resource.data.lado == 'gestion' && esGestor(empresaId)));
      allow update, delete: if false;
    }

    // ---------- Catálogo público (lo ve cualquiera, sin cuenta) ----------
    // Es una copia mínima: nombre, contacto, color y los productos visibles.
    // Nunca lleva recetas, costos ni stock.
    match /catalogos/{empresaId} {
      allow read: if true;
      allow create, update: if esGestor(empresaId)
        && request.resource.data.keys().hasOnly(['nombre', 'whatsapp', 'color', 'logoUrl', 'moneda',
             'pais', 'idioma', 'items', 'actualizadoEn'])
        && (!('items' in request.resource.data) || request.resource.data.items.size() <= 300);
      allow delete: if esGestor(empresaId);
    }

    // ---------- Datos de la plataforma ----------
    match /plataforma/cobro {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    match /pagos/{pagoId} {
      allow read, create: if isSuper();
      allow update, delete: if false;
    }
  }
}
